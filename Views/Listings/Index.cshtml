@model IEnumerable<Lotomoto.Models.CarListing>

@{
    ViewData["Title"] = "Ogłoszenia";
    var categories = (IEnumerable<string>)ViewData["Categories"]!;
    var selectedCategory = ViewData["SelectedCategory"] as string;
    var query = ViewData["Query"] as string;
    var minYear = ViewData["MinYear"] as int?;
    var maxYear = ViewData["MaxYear"] as int?;
    var minPrice = ViewData["MinPrice"] as decimal?;
    var maxPrice = ViewData["MaxPrice"] as decimal?;
}

<div class="page-header mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h1 class="display-6">Przeglądaj ogłoszenia</h1>
            <p class="text-muted">Znajdź samochód dopasowany do Twoich potrzeb: od sportowych coupe po wygodne SUV-y.</p>
        </div>
        <a class="btn btn-primary btn-lg" asp-controller="Admin" asp-action="Dashboard">Panel admina</a>
    </div>
</div>

<div class="card mb-4 shadow-sm filter-panel">
    <div class="card-body">
        <form method="get" class="row gy-3 gx-3">
            <div class="col-12 col-lg-4">
                <label class="form-label" for="query">Szukaj</label>
                <input id="query" name="query" class="form-control" value="@query" placeholder="Marka, model, opis..." />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="category">Rodzaj</label>
                <select id="category" name="category" class="form-select">
                    <option value="">Wszystkie</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(cat == selectedCategory ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="minYear">Rok od</label>
                <input id="minYear" name="minYear" type="number" class="form-control" value="@(minYear?.ToString() ?? string.Empty)" placeholder="2010" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="maxYear">Rok do</label>
                <input id="maxYear" name="maxYear" type="number" class="form-control" value="@(maxYear?.ToString() ?? string.Empty)" placeholder="2025" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="minPrice">Cena min</label>
                <input id="minPrice" name="minPrice" type="number" class="form-control" value="@(minPrice?.ToString() ?? string.Empty)" placeholder="0" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="maxPrice">Cena max</label>
                <input id="maxPrice" name="maxPrice" type="number" class="form-control" value="@(maxPrice?.ToString() ?? string.Empty)" placeholder="200000" />
            </div>
            <div class="col-12 col-lg-3 align-self-end">
                <button type="submit" class="btn btn-outline-primary w-100">Filtruj</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Brak ogłoszeń spełniających kryteria. Spróbuj zmienić filtr.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <article class="card listing-card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Zdjęcie @item.Title" loading="lazy" />
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@item.Title</h2>
                        <p class="text-primary fs-5 fw-semibold mb-2">@item.Price.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("pl-PL"))</p>
                        <p class="mb-2 text-muted">@item.Year · @item.Mileage km · @item.Category</p>
                        <p class="card-text text-truncate">@item.Description</p>
                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mt-3">Zobacz szczegóły</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
